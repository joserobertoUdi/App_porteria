<?xml version="1.0" encoding="utf-8"?>
<!--
    Variante para Android 5 y superiores. Misma composición que
    drawable/launch_background.xml, pero respetando el fondo del sistema para
    que el modo oscuro no muestre un rectángulo blanco antes de tiempo.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
