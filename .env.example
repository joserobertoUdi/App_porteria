# ==============================================================================
# Variables de entorno del backend (copie este archivo a .env y complete valores)
# En Windows: setx VARIABLE "valor"  |  PowerShell: $env:VARIABLE="valor"
# Los valores marcados con CAMBIAR son obligatorios en produccion.
# ==============================================================================

# ---- Base de datos (SQL Server) ----
DB_CONNECTION_STRING=Server=localhost;Database=UniversidadDB;Trusted_Connection=True;TrustServerCertificate=True

# ---- JWT (obligatorios) ----
JWT_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA_DE_AL_MENOS_32_CARACTERES
JWT_ISSUER=UDI
JWT_AUDIENCE=app-universidad
JWT_EXPIRE_MINUTES=720
JWT_REFRESH_TOKEN_DAYS=0.5

# ---- Autenticacion (bloqueo por intentos fallidos) ----
AUTH_MAX_INTENTOS_FALLIDOS=5
AUTH_DURACION_BLOQUEO_MIN=15

# ---- Seed inicial (opcional) ----
# Solo crea el administrador si SEED_ADMIN_PASSWORD esta definida.
SEED_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_ADMIN_SEGURA
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_DOCUMENTO=admin
SEED_ADMIN_TIPO_USUARIO_ID=1
SEED_ADMIN_ROL_ID=1

# Usuarios de demonstracion (porteros). Deshabilitar en produccion.
SEED_USUARIOS_DEMO=false
SEED_PORTERO_PARQUEO_PASSWORD=CAMBIAR
SEED_PORTERO_PORTERIA_PASSWORD=CAMBIAR

# ---- Servicios externos ----
# URL base del servicio de gestion documental (SharepointApi).
# En produccion debe ser HTTPS.
SHAREPOINT_BASE_URL=http://10.1.210.10/SharepointApi

# ProviderKey para autenticacion con SharepointApi (obligatorio).
PROVIDER_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA
